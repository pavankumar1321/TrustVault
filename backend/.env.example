# TrustVault Backend Configuration
PROJECT_NAME="TrustVault"
ENVIRONMENT="development"
DEBUG=true

# Database: PostgreSQL for production/local, or SQLite fallback for portable dev/tests
# PostgreSQL example: postgresql://trustvault_user:trustvault_pass@localhost:5432/trustvault_db
# SQLite fallback: sqlite:///./trustvault.db
DATABASE_URL="sqlite:///./trustvault.db"

# Session & Security
# Generate secure keys using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="trustvault-super-secure-dev-secret-change-in-production-32bytes"
SESSION_COOKIE_NAME="trustvault_session"
CSRF_COOKIE_NAME="trustvault_csrf"
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Storage
STORAGE_DIR="storage/documents"
MAX_UPLOAD_SIZE_MB=15

# Initial Admin Bootstrap (Used by bootstrap script)
BOOTSTRAP_ADMIN_EMAIL="admin@trustvault.local"
BOOTSTRAP_ADMIN_PASSWORD="AdminChangeMe123!"
BOOTSTRAP_ADMIN_NAME="System Administrator"

# CORS configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
